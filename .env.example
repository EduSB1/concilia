# Copie este arquivo para .env e preencha com credenciais reais.
# O .env está no .gitignore e nunca deve ser versionado.
# Em produção, defina estas variáveis no painel do provedor de hospedagem.

# --- Banco de dados ---
DATABASE_URL=postgresql://usuario:senha@localhost:5432/concilia

# --- Aplicação ---
FLASK_ENV=development
SECRET_KEY=troque-por-uma-string-aleatoria-de-32-caracteres

# --- Banco Inter PJ ---
# Certificado e chave emitidos pelo internet banking PJ, codificados em Base64.
INTER_CERT_B64=
INTER_KEY_B64=
INTER_CONTA_CORRENTE=

# --- Mercado Pago ---
# Access token de produção (começa com APP_USR-).
MP_ACCESS_TOKEN=

# --- Bling ---
# Credenciais da aplicação cadastrada na API v3.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# --- Shopee (conector em validação) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# --- TikTok Shop (conector em validação) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_ID=
